# Context menu

msgctxt "#32001"
msgid "Cast with LocalCast"
msgstr "Trasmetti con LocalCast"

# Settings

msgctxt "#32010"
msgid "General"
msgstr "Generale"

msgctxt "#32011"
msgid "Automatic casting writes a playercorefactory.xml into your Kodi profile so that every video Kodi plays opens in LocalCast."
msgstr "La trasmissione automatica scrive un file playercorefactory.xml nel tuo profilo Kodi, così ogni video riprodotto da Kodi si apre in LocalCast."

msgctxt "#32012"
msgid "Automatic casting"
msgstr "Trasmissione automatica"

msgctxt "#32013"
msgid "Enable automatic casting"
msgstr "Attiva la trasmissione automatica"

msgctxt "#32014"
msgid "Every video Kodi plays opens in LocalCast. Kodi must be restarted afterwards."
msgstr "Ogni video riprodotto da Kodi si apre in LocalCast. Successivamente Kodi deve essere riavviato."

msgctxt "#32015"
msgid "Disable automatic casting"
msgstr "Disattiva la trasmissione automatica"

msgctxt "#32016"
msgid "Removes the playercorefactory.xml written by LocalCast. Kodi must be restarted afterwards."
msgstr "Rimuove il file playercorefactory.xml scritto da LocalCast. Successivamente Kodi deve essere riavviato."

msgctxt "#32017"
msgid "Status"
msgstr "Stato"

msgctxt "#32018"
msgid "Shows whether automatic casting is on and where the configuration file lives."
msgstr "Mostra se la trasmissione automatica è attiva e dove si trova il file di configurazione."

msgctxt "#32019"
msgid "Help"
msgstr "Aiuto"

msgctxt "#32020"
msgid "How the add-on works and what it needs."
msgstr "Come funziona l'add-on e di cosa ha bisogno."

# Dialogs and notifications

msgctxt "#32031"
msgid "A playercorefactory.xml that LocalCast did not write already exists. Replace it? A backup (.localcast.bak) is kept."
msgstr "Esiste già un file playercorefactory.xml non scritto da LocalCast. Sostituirlo? Viene conservata una copia di backup (.localcast.bak)."

msgctxt "#32032"
msgid "Done. Kodi must be restarted for the change to apply. Close Kodi now? (Start it again from your launcher.)"
msgstr "Fatto. Per applicare la modifica Kodi deve essere riavviato. Chiudere Kodi adesso? (Riavvialo dal tuo launcher.)"

msgctxt "#32033"
msgid "Restart Kodi to apply"
msgstr "Riavvia Kodi per applicare la modifica"

msgctxt "#32034"
msgid "Automatic casting is already off"
msgstr "La trasmissione automatica è già disattivata"

msgctxt "#32035"
msgid "This playercorefactory.xml was not written by LocalCast; delete it with Kodi's file manager if you want it gone"
msgstr "Questo playercorefactory.xml non è stato scritto da LocalCast; eliminalo con il gestore file di Kodi se vuoi rimuoverlo"

msgctxt "#32036"
msgid "A backup of the previous playercorefactory.xml (.localcast.bak) exists. Restore it?"
msgstr "Esiste una copia di backup del precedente playercorefactory.xml (.localcast.bak). Ripristinarla?"

msgctxt "#32037"
msgid "Automatic casting is on: every video Kodi plays opens in LocalCast."
msgstr "La trasmissione automatica è attiva: ogni video riprodotto da Kodi si apre in LocalCast."

msgctxt "#32038"
msgid "Automatic casting is off: Kodi plays videos itself."
msgstr "La trasmissione automatica è disattivata: Kodi riproduce i video da solo."

msgctxt "#32039"
msgid "A playercorefactory.xml that LocalCast did not write is in place. Automatic casting is not active."
msgstr "È presente un playercorefactory.xml non scritto da LocalCast. La trasmissione automatica non è attiva."

msgctxt "#32040"
msgid "File: %s"
msgstr "File: %s"

msgctxt "#32041"
msgid "Automatic casting: every video Kodi plays opens in LocalCast, which casts it to your TV. Turn it on in the add-on settings; Kodi must be restarted once.[CR][CR]Context menu: open the context menu on a single video and choose \"Cast with LocalCast\" to send just that item.[CR][CR]Streams from Kodi add-ons (plugin://) can only be cast in automatic mode, because Kodi resolves them only while playing them itself.[CR][CR]Requires the LocalCast app from Google Play.[CR][CR]More at localcast.app/kodi"
msgstr "Trasmissione automatica: ogni video riprodotto da Kodi si apre in LocalCast, che lo trasmette al tuo televisore. Attivala nelle impostazioni dell'add-on; Kodi deve essere riavviato una volta.[CR][CR]Menu contestuale: apri il menu contestuale di un singolo video e scegli \"Trasmetti con LocalCast\" per inviare solo quell'elemento.[CR][CR]I flussi degli add-on di Kodi (plugin://) possono essere trasmessi solo in modalità automatica, perché Kodi li risolve solo quando li riproduce da solo.[CR][CR]Richiede l'app LocalCast da Google Play.[CR][CR]Maggiori informazioni su localcast.app/kodi"

msgctxt "#32042"
msgid "Android only"
msgstr "Disponibile solo su Android"

msgctxt "#32043"
msgid "Nothing to cast"
msgstr "Niente da trasmettere"

msgctxt "#32044"
msgid "This item comes from a Kodi add-on. Kodi only resolves such streams when it plays them itself, so turn on automatic casting (LocalCast add-on → Enable) to cast it."
msgstr "Questo elemento proviene da un add-on di Kodi. Kodi risolve questi flussi solo quando li riproduce da solo, quindi attiva la trasmissione automatica (add-on LocalCast → Attiva) per trasmetterlo."

msgctxt "#32045"
msgid "Sent to LocalCast"
msgstr "Inviato a LocalCast"

msgctxt "#32046"
msgid "The LocalCast add-on ran into an error (%s). Details are in the Kodi log."
msgstr "L'add-on LocalCast ha riscontrato un errore (%s). I dettagli sono nel registro di Kodi."

msgctxt "#32047"
msgid "Backup restored"
msgstr "Backup ripristinato"
